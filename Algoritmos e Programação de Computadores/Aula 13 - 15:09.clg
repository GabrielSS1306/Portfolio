algoritmo semNome;
// Síntese
//  Objetivo:  
//  Entrada :
//  Saída   :


principal
	// Declarações

inteiro i; 
inteiro vet[10];
real soma, media;

soma = 0;
media = 0; 

para (i de 0 ate 9 passo 1) faca 
escreva ("Digite o valor da posição ",i,":");
leia (vet[i]);
soma = soma+vet[i];
fimPara

para (i de 0 ate 9 passo 1) faca 
escreval (vet[i]);
fimPara
media = soma/i;
escreval ("A soma dos números é: ",soma);
escreval ("A média aritmética dos números é: ",media::2);

	// Instruções

fimPrincipal

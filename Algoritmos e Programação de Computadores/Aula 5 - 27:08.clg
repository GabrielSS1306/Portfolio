algoritmo semNome;
// Síntese
//  Objetivo:  
//  Entrada :
//  Saída   :


principal
	// Declarações

inteiro num; 

escreva ("Informe um número: ");
leia(num);

se (num % 2 == 0) entao
escreva ("O número ", num, " é par.");

senao 
escreva ("O número ", num, " é ímpar.");

fimSe
	// Instruções

fimPrincipal
	